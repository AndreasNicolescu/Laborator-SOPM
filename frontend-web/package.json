{
  "name": "frontend-web",
  "private": true,
  "version": "0.0.0",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron . --dev",
    "electron:pack": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  },
  "build": {
  "appId": "com.weatherchatbot.desktop",
  "productName": "Weather Chatbot",
  "extraResources": [
    {
      "from": "extra",
      "to": "extra",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": "nsis"
  },
  "directories": {
    "output": "release"
   }
  }
}